# Copy relevant vars to root .env

# Which LLM backend to use: ollama (default, free local) | groq (free tier) | gemini (free tier)
LLM_PROVIDER=ollama

# Ollama — install from https://ollama.com, then: ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2

# Groq free tier — https://console.groq.com
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# LLM_MODEL=llama-3.1-8b-instant

# Gemini free tier — https://aistudio.google.com/app/apikey
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=AIza...
# LLM_MODEL=gemini-1.5-flash

# Shared secret between main API and this service
AI_SERVICE_KEY=change-me-in-production

# Port for this service (default 4001)
AI_PORT=4001

# Postgres — same as main API
DATABASE_URL=postgresql://user:pass@localhost:5432/school
