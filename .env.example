# Copy to .env and fill in. Never commit .env.

# ---- Database (hosted Postgres — Neon or Supabase free tier) ----
# Neon:     Dashboard > Connection Details > copy the "psql" / direct string.
# Supabase: Project Settings > Database > Connection string > "URI" tab.
#           Use the DIRECT connection (port 5432), NOT the pooled 6543 one —
#           Prisma Migrate needs a direct connection. Supabase has an ap-south-1
#           (Mumbai) region, which matches the DPDP data-residency goal.
# Keep ?sslmode=require for both providers.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# ---- Redis ----
# A local Redis service is expected on 6379. (Not load-bearing yet — BullMQ
# queues are not wired in. Safe to leave as-is even if Redis is down.)
REDIS_URL="redis://localhost:6379"

# ---- API ----
API_HOST="0.0.0.0"
API_PORT="4000"
NODE_ENV="development"
# Comma-separated origins allowed to call the API
CORS_ORIGINS="http://localhost:5173"
# HS256 secret for signing session JWTs (dev only — use a real secret manager in prod)
JWT_SECRET="dev-only-change-me"
JWT_EXPIRES_IN="30d"

# ---- Auth / OTP (MSG91 or similar India SMS provider) ----
# Leave OTP_PROVIDER=console in dev to print OTPs to the API log instead of sending SMS.
OTP_PROVIDER="console"
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
MSG91_OTP_TEMPLATE_ID=""
OTP_TTL_SECONDS="300"

# ---- Web ----
VITE_API_BASE_URL="http://localhost:4000"
