{
  "name": "iskool",
  "private": true,
  "version": "0.0.0",
  "description": "Multi-tenant school management platform for the Indian K-12 market",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web dev:ai",
    "dev:api": "npm run dev --workspace @iskool/api",
    "dev:web": "npm run dev --workspace @iskool/web",
    "dev:ai": "uvicorn apps/ai/main:app --reload --port 4001 --env-file .env",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:generate": "npm run generate --workspace @iskool/db",
    "db:migrate": "npm run migrate --workspace @iskool/db",
    "db:seed": "npm run seed --workspace @iskool/db",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "npm-run-all": "4.1.5",
    "typescript": "5.7.3"
  }
}
